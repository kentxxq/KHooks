{
  "name": "khooks",
  "productName": "KHooks",
  "version": "0.7.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:windows-events": "dotnet publish native/windows-events/WindowsEvents.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=None --artifacts-path debug/tmpfile-AI-dotnet -o debug/tmpfile-AI-windows-events",
    "package:win": "vp run build:windows-events && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "jsonpath-plus": "^10.4.0",
    "write-file-atomic": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@nuxt/ui": "^4.0.0",
    "@playwright/test": "^1.61.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-horizontal-rule": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-mention": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "@tiptap/vue-3": "3.34.0",
    "@types/node": "^24.0.0",
    "@types/write-file-atomic": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vueuse/core": "^14.0.0",
    "@xyflow/vue": "2.0.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "pinia": "^3.0.0",
    "resedit": "1.7.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.0",
    "vue-tsc": "^3.3.13"
  }
}
