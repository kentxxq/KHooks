{
  "name": "khooks",
  "version": "0.9.2",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "build:windows-events": "cargo build --manifest-path native/windows-events/Cargo.toml --release --target-dir debug/tmpfile-AI-rust && node -e \"const fs = require('node:fs'); fs.mkdirSync('debug/tmpfile-AI-windows-events', { recursive: true }); fs.copyFileSync('debug/tmpfile-AI-rust/release/WindowsEvents.exe', 'debug/tmpfile-AI-windows-events/WindowsEvents.exe')\"",
    "package:win": "vp run build:windows-events && electron-builder --win nsis --x64 --publish never",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "jsonpath-plus": "^10.4.0",
    "write-file-atomic": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@nuxt/ui": "^4.0.0",
    "@playwright/test": "^1.61.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-horizontal-rule": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-mention": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "@tiptap/vue-3": "3.34.0",
    "@types/node": "^24.0.0",
    "@types/write-file-atomic": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vueuse/core": "^14.0.0",
    "@xyflow/vue": "2.0.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "pinia": "^3.0.0",
    "resedit": "1.7.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.44",
    "vue-router": "^4.6.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.21.0",
  "productName": "KHooks"
}
